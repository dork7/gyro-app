{
  "name": "gyro-fruit-slicer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fruit-slicing game on your laptop, controlled by your phone's gyroscope.",
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build",
    "start": "npm run build && tsx server/index.ts --prod",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "sirv": "^2.0.4",
    "tsx": "^4.19.0",
    "vite": "^5.4.11",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
